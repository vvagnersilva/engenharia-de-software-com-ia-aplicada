# OpenRouter (usado pelo Spring AI apontando spring.ai.openai.base-url para a API do OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Postgres (docker-compose.yml próprio deste projeto, porta 5433 para não colidir
# com o Postgres do projeto 04-song-highlights-z, que usa a porta 5432)
POSTGRES_PASSWORD=mysecretpassword
