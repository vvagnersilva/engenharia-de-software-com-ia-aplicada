<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.dev.showcase.mcp</groupId>
        <artifactId>mcp-java-showcase</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>showcase-core</artifactId>
    <name>Showcase Core</name>
    <description>Capacidades MCP (tools, resources, prompts, completions, sampling, elicitation, roots) independentes de transporte</description>

    <dependencies>
        <!-- Contexto Spring, sem servidor web: o transporte e escolhido pelas aplicacoes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Anotacoes @McpTool, @McpResource, @McpPrompt, @McpComplete e o McpSyncRequestContext -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp-annotations</artifactId>
        </dependency>

        <!-- Customizers do servidor MCP (usados para ajustar as capabilities antes do build) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp</artifactId>
        </dependency>

        <!-- @Nullable do JSpecify: o gerador de schema do Spring AI usa essa anotacao
             para marcar campos de records aninhados como opcionais -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- @JsonInclude: o Jackson 3 (tools.jackson) continua lendo as anotacoes
             do pacote com.fasterxml.jackson.annotation -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
    </dependencies>
</project>
