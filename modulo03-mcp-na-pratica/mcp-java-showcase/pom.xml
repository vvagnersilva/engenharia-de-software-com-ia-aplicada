<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      POM raiz do monorepo. Herda do spring-boot-starter-parent para ganhar o
      gerenciamento de versoes do Spring Boot e a configuracao do plugin de build.
      As versoes do Spring AI e do MCP Java SDK entram via BOM (dependencyManagement).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>br.dev.showcase.mcp</groupId>
    <artifactId>mcp-java-showcase</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>MCP Java Showcase</name>
    <description>Projeto de referencia cobrindo todos os recursos do MCP Java SDK com Spring Boot</description>

    <modules>
        <module>showcase-core</module>
        <module>showcase-server-stdio</module>
        <module>showcase-server-webmvc</module>
        <module>showcase-server-webflux</module>
        <module>showcase-client</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versoes verificadas no Maven Central (2026-07) -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <mcp-sdk.version>2.0.0</mcp-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM do Spring AI: define as versoes dos starters MCP -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- BOM do MCP Java SDK: usado onde caimos no SDK puro (ex.: roots, ping, paginacao) -->
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>${mcp-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Toda camada do projeto e testada com JUnit 5 + AssertJ (vem do starter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Failsafe roda os *IT.java na fase integration-test, depois do package:
                 e o que permite ao teste STDIO subir o jar empacotado como subprocesso -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
