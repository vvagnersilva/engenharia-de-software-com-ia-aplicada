<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.dev.showcase.mcp</groupId>
        <artifactId>mcp-java-showcase</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>showcase-client</artifactId>
    <name>Showcase Client</name>
    <description>Cliente MCP que conecta nos tres transportes e exercita todas as capacidades</description>

    <dependencies>
        <!-- Starter de cliente MCP com transporte Streamable HTTP via WebFlux;
             ja traz o transporte STDIO do starter comum -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client-webflux</artifactId>
        </dependency>

        <!-- API REST de demonstracao -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- LLM real para sampling. Fica inerte por padrao: application.yml define
             spring.ai.model.chat=none, e so o perfil real-llm ativa o ChatModel.
             Assim o projeto roda sem nenhuma chave de API. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
